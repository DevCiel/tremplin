{
  "name": "tremplin",
  "version": "0.8.0-beta.0",
  "tremplinMigration": {
    "profile": "strict-core-unreleased",
    "releaseBlocked": true
  },
  "description": "A modern, accessible, token-first frontend framework by Devciel.",
  "license": "MIT",
  "author": "Devciel",
  "homepage": "https://gettremplin.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevCiel/tremplin.git"
  },
  "type": "module",
  "style": "dist/css/tremplin.css",
  "sass": "src/scss/tremplin.scss",
  "files": [
    "dist",
    "!dist/cjs/**",
    "!dist/types/**",
    "!dist/js/adapters/**",
    "!dist/js/extensions/**",
    "!dist/css/tremplin-extensions*",
    "!dist/strict-build-graph.json",
    "js/dist",
    "src/js",
    "!src/js/extensions/**",
    "src/scss",
    "!src/scss/extensions/**",
    "metadata/api.json",
    "metadata/public-api.json",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "GOVERNANCE.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "sideEffects": [
    "*.css",
    "*.scss",
    "./src/js/**/*.ts",
    "./js/dist/**/*.js",
    "./dist/js/**/*.js"
  ],
  "exports": {
    ".": {
      "types": "./js/dist/index.d.ts",
      "default": "./js/dist/index.js"
    },
    "./css": "./dist/css/tremplin.css",
    "./css/min": "./dist/css/tremplin.min.css",
    "./css/grid": "./dist/css/tremplin-grid.css",
    "./css/reboot": "./dist/css/tremplin-reboot.css",
    "./css/utilities": "./dist/css/tremplin-utilities.css",
    "./bundle": "./dist/js/tremplin.bundle.min.js",
    "./scss": "./src/scss/tremplin.scss",
    "./scss/*": "./src/scss/*",
    "./*": {
      "types": "./js/dist/*.d.ts",
      "default": "./js/dist/*.js"
    },
    "./js/dist/*": "./js/dist/*"
  },
  "scripts": {
    "clean": "node tests/tooling/clean-distribution.mjs",
    "build:css": "npm run css-compile && npm run css-prefix && npm run css-minify && npm run css-docs && npm run build:css:assets",
    "build:css:assets": "node build/generate-sri.mjs --assets-only",
    "build:api": "node tests/tooling/generate-api.mjs && node tests/tooling/generate-public-api.mjs",
    "build:docs-tokens": "node tests/tooling/generate-documentation-tokens.mjs",
    "check:docs-tokens": "node tests/tooling/generate-documentation-tokens.mjs --check",
    "build:js": "npm run js-build && npm run js-compile-plugins && npm run js-emit-types",
    "js-compile-plugins": "node build/build-plugins.mjs",
    "js-emit-types": "node node_modules/typescript-bootstrap/bin/tsc --project build/tsconfig.dts.json",
    "build:core-preview": "node tests/tooling/compile-preview.mjs",
    "build:js:browser": "npm run js-build",
    "build:manifest": "node build/generate-sri.mjs && node tests/tooling/check-compiled-core.mjs && node tests/tooling/check-core-output.mjs",
    "build": "npm run check:no-legacy && npm run clean && npm run check:tremplin && npm run build:api && npm run check:api && npm run build:css && npm run build:js && npm run build:manifest && npm run check:size && npm run check:no-legacy && npm run build:core-preview",
    "site:prepare": "node site/build/assets.mjs && node site/build/documentation-assets.mjs && node site/build/runtime.mjs && node build/copy-site.mjs",
    "site:dev": "npm run site:prepare && astro dev --host 127.0.0.1 --port 4321",
    "test:site:style": "playwright test --config playwright.site-style.config.ts",
    "test:site:contrast": "playwright test --config playwright.contrast-docs.config.ts",
    "report:site:contrast": "node tests/tooling/report-contrast-preview.mjs",
    "report:site:style": "node tests/tooling/report-site-style.mjs",
    "site:build": "npm run check:docs-tokens && npm run site:prepare && astro build && pagefind --site site-dist && npm run check:no-legacy && npm run check:site-assets",
    "build:site": "npm run build && npm run site:build",
    "test": "vitest run",
    "test:sass:foundation": "vitest run tests/breakpoint-api.test.ts tests/cascade-layers.test.ts tests/layout-defaults.test.ts tests/css-grid.test.ts tests/layout-generators.test.ts tests/responsive-layout.test.ts tests/spacing-defaults.test.ts --maxWorkers=2",
    "test:sass:grid-utilities": "vitest run tests/grid-bundle.test.ts tests/grid-gap-utilities.test.ts --maxWorkers=2",
    "test:sass:helpers": "vitest run tests/detail-helpers.test.ts tests/stack-position-helpers.test.ts tests/hover-lift.test.ts tests/helpers-docs.test.ts --maxWorkers=2",
    "test:sass:utility-api": "vitest run tests/utility-generator.test.ts tests/utility-selectors.test.ts tests/utility-values.test.ts tests/utility-variants.test.ts tests/utility-api-docs.test.ts --maxWorkers=2",
    "test:sass:utility-families": "vitest run tests/utility-families.test.ts tests/color-role-utilities.test.ts tests/theme-utilities.test.ts tests/surface-utilities.test.ts tests/underline-utilities.test.ts tests/sizing-utilities.test.ts tests/utilities-docs.test.ts --maxWorkers=2",
    "test:sass:mixed-docs": "vitest run tests/styles.test.ts tests/structure.test.ts tests/metadata.test.ts tests/content-docs.test.ts tests/customize-docs.test.ts tests/layout-docs.test.ts --maxWorkers=2",
    "test:js:fixtures": "vitest run tests/components.test.ts tests/discovery.test.ts tests/interactions.test.ts --maxWorkers=2",
    "test:js:fixtures:reference": "vitest run --config vitest.js-reference.config.ts",
    "test:browser": "playwright test",
    "test:server": "node --test tests/tooling/serve.test.mjs tests/tooling/check-no-legacy.test.mjs tests/tooling/site-assets.test.mjs",
    "test:site:legacy-free": "playwright test --config playwright.legacy-removal.config.ts",
    "test:site:grid-utilities": "playwright test --config playwright.grid-utilities.config.ts",
    "test:site:helpers": "playwright test --config playwright.helpers.config.ts",
    "test:site:utility-api": "playwright test --config playwright.utility-api.config.ts",
    "test:site:utility-families": "playwright test --config playwright.utility-families.config.ts",
    "test:site:mixed-docs": "playwright test --config playwright.mixed-docs.config.ts",
    "test:browser:js-fixtures": "playwright test --config playwright.js-fixtures.config.ts",
    "test:browser:layout-collection": "playwright test --config playwright.layout-collection.config.ts",
    "test:csp": "playwright test tests/browser/csp.spec.ts",
    "test:a11y": "playwright test tests/browser/accessibility.spec.ts",
    "test:site": "playwright test --config playwright.site.config.ts",
    "test:site:contracts": "playwright test --config playwright.docs-contracts.config.ts",
    "test:site:audit": "playwright test --config playwright.site-audit.config.ts",
    "report:site:audit": "node tests/tooling/summarize-site-audit.mjs",
    "test:site:controls": "playwright test --config playwright.strict-docs.config.ts",
    "test:site-visual": "playwright test --config playwright.docs-visual.config.ts",
    "test:site-visual:update": "playwright test --config playwright.docs-visual.config.ts --update-snapshots",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots",
    "test:package": "node tests/tooling/test-package.mjs",
    "test:watch": "vitest",
    "typecheck": "node node_modules/typescript-bootstrap/bin/tsc -p tsconfig.core.json --noEmit",
    "typecheck:tests": "node node_modules/typescript-bootstrap/bin/tsc -b tsconfig.core-types.json --force && node node_modules/typescript-bootstrap/bin/tsc -p tsconfig.json --noEmit",
    "test:typecheck-boundaries": "npm run typecheck:tests && node tests/tooling/check-test-type-boundaries.mjs",
    "check:size": "node tests/tooling/check-size.mjs",
    "check:api": "node tests/tooling/check-strict-api.mjs",
    "audit:tremplin": "node tests/tooling/audit-tremplin-core.mjs",
    "check:tremplin": "node tests/tooling/audit-tremplin-core.mjs --check",
    "check:production-css": "node tests/tooling/check-production-css.mjs",
    "validate:tremplin-stage": "node tests/tooling/validate-tremplin-stage.mjs",
    "test:tremplin-stage": "node tests/tooling/test-tremplin-stage.mjs",
    "test:tremplin-production": "node tests/tooling/test-tremplin-stage.mjs --production",
    "build:tremplin-integrations": "node tests/tooling/build-tremplin-integrations.mjs",
    "test:tremplin-integrations": "npm run build:tremplin-integrations && playwright test --config playwright.strict-integrations.config.ts",
    "check:release": "node tests/tooling/check-release.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run check && npm run check:release && changeset publish",
    "prepublishOnly": "npm run check:release",
    "check": "npm run typecheck && npm run build && npm run test:typecheck-boundaries && npm run check:production-css && npm run site:prepare && npm test && npm run test:js:fixtures:reference && npm run test:package && npm run test:server && npm run test:browser && npm run test:visual && npm run site:build && npm run test:site && npm run test:site-visual",
    "check:no-legacy": "node tests/tooling/check-no-legacy.mjs",
    "check:site-assets": "node tests/tooling/check-site-assets.mjs",
    "bundlewatch": "node build/bundlewatch-table.mjs",
    "bundlewatch:fix": "node build/bundlewatch-fix.mjs",
    "change-version": "node build/change-version.mjs",
    "check:unused-imports": "node build/check-unused-imports.mjs src/scss",
    "clean:astro": "node build/clean-astro.mjs",
    "docs:prep": "node tests/tooling/prepare-docs-review.mjs",
    "validate:html": "node build/html-validate.mjs",
    "css": "npm run build:css",
    "css-compile": "sass --style=expanded --source-map --embed-sources --no-error-css src/scss/tremplin.scss:dist/css/tremplin.css src/scss/tremplin-grid.scss:dist/css/tremplin-grid.css src/scss/tremplin-reboot.scss:dist/css/tremplin-reboot.css src/scss/tremplin-utilities.scss:dist/css/tremplin-utilities.css",
    "css-prefix": "node build/postcss.config.mjs --prefix",
    "css-minify": "node build/css-minify.mjs",
    "css-docs": "node build/generate-utilities-json.mjs --verify-reference",
    "js": "npm run build:js",
    "js-build": "npm run js-compile && npm run js-minify",
    "js-compile": "npm run js-compile-standalone && npm run js-compile-bundle",
    "js-compile-standalone": "rolldown --environment BUNDLE:false --config build/rolldown.config.mjs --sourcemap",
    "js-compile-bundle": "rolldown --environment BUNDLE:true --config build/rolldown.config.mjs --sourcemap",
    "js-minify": "npm run js-minify-standalone && npm run js-minify-bundle",
    "js-minify-standalone": "terser --compress passes=2 --mangle --comments \"/^!/\" --source-map \"content=dist/js/tremplin.js.map,includeSources,filename=tremplin.min.js,url=tremplin.min.js.map\" --output dist/js/tremplin.min.js dist/js/tremplin.js",
    "js-minify-bundle": "terser --compress passes=2 --mangle --comments \"/^!/\" --source-map \"content=dist/js/tremplin.bundle.js.map,includeSources,filename=tremplin.bundle.min.js,url=tremplin.bundle.min.js.map\" --output dist/js/tremplin.bundle.min.js dist/js/tremplin.bundle.js",
    "dist": "npm run build",
    "screenshots": "node build/screenshot-examples.mjs",
    "release-zip-examples": "node build/zip-examples.mjs"
  },
  "devDependencies": {
    "@astrojs/mdx": "^8.1.1",
    "@axe-core/playwright": "^4.14.0",
    "@changesets/cli": "^3.0.3",
    "@floating-ui/dom": "^1.8.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitest/browser-playwright": "^5.0.5",
    "astro": "^7.4.2",
    "autoprefixer": "10.6.2",
    "browserslist": "4.28.9",
    "esbuild": "^0.27.2",
    "hammer-simulator": "^0.0.1",
    "html-validate": "11.17.0",
    "jsdom": "^27.0.0",
    "globby": "16.2.4",
    "lightningcss": "1.33.0",
    "pagefind": "^1.5.2",
    "postcss": "^8.5.31",
    "postcss-prefix-custom-properties": "0.1.0",
    "react": "^19.0.0",
    "react-dom": "19.0.0",
    "rolldown": "1.2.0",
    "sass": "^1.93.0",
    "sass-true": "^10.1.0",
    "tsup": "^8.5.0",
    "terser": "5.51.2",
    "typescript": "^5.9.0",
    "typescript-bootstrap": "npm:typescript@6.0.3",
    "vanilla-calendar-pro": "^3.4.0",
    "vitest": "^5.0.5",
    "vue": "^3.5.0",
    "sharp": "0.35.5",
    "fflate": "0.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@floating-ui/dom": "^1.8.0",
    "vanilla-calendar-pro": "^3.4.0"
  },
  "keywords": [
    "css",
    "framework",
    "responsive",
    "sass",
    "typescript",
    "ui",
    "accessibility"
  ]
}
