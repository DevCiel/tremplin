---
import { utilitiesRuntimeScripts } from '../data/utilities-examples'
import { helpersRuntimeScripts } from '../data/helpers-examples'
import { formsRuntimeScripts } from '../data/forms-examples'
interface Props { slug: string }
const source = formsRuntimeScripts[Astro.props.slug] ?? helpersRuntimeScripts[Astro.props.slug] ?? utilitiesRuntimeScripts[Astro.props.slug]
---
{source && <script is:inline type="module" set:html={source.replaceAll("from 'tremplin'", "from '/js/tremplin-docs.min.js'")}></script>}
