---
import { componentApiEvents } from '../../data/component-api'
interface Props { name: string }
const events = componentApiEvents(Astro.props.name)
---
{events.length ? <div class="table-responsive" tabindex="0" role="region" aria-label="Scrollable lifecycle events"><table class="table"><thead><tr><th scope="col">Event</th><th scope="col">When it fires</th></tr></thead><tbody>{events.map(event => <tr><td><code>{event.event}</code></td><td>{event.description}</td></tr>)}</tbody></table></div> : <p>This component does not emit component-specific lifecycle events.</p>}
